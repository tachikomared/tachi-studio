node_modules/
out/
dist/
dist-rel/
dist-release/
release-build/
*.local
.DS_Store

# Local windowless app launchers (machine-specific absolute paths)
/launch-tachi.vbs
*.lnk

# Sidecar binaries & source (fetched at build time via prepare:sidecars)
apps/desktop/resources/sidecars/

# Git worktrees
.worktrees/

# Product screenshots are NOT published. The captured set showed the maintainer's
# machine name, Windows account, GitHub handle and wallet address; a public repo
# keeps those in history forever. Re-capture on a clean profile before adding any
# back, and check every panel — not just the one you meant to show.
website-landing/media/shots/

# Local MCP wiring: a real .mcp.json holds absolute paths from the machine it was
# written on (the committed one carried a Windows account name). Copy
# .mcp.json.example instead.
/.mcp.json

# Claude Code agent worktrees + brainstorm session caches (transient)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.clone/
.superpowers/brainstorm/

# Transient screenshots (use docs/ if intentional)
screen.png

# Transient tsc / diagnostic output logs
.tsc-out.txt
*.tsc-out.txt

# Research scratch (third-party repo clones + steal-digest tooling; regenerable)
.research-tmp/
# Vendored research clones (each is its own git repo; studied, not part of this app)
/CodexMonitor/
/checkcle/
/homepage/
/latmd/
/uiverse-galaxy/
# Transient scratch (one-off fix scripts, tsc baseline dumps)
.tmp/

# Playwright e2e screenshots (local QA artifacts)
apps/desktop/e2e/shots/

# generated by website/scripts/copy-md.mjs (raw-markdown copies for llms.txt links)
website/public/guide/
website/.vitepress/cache/
apps/desktop/release-build2/

# ---------------------------------------------------------------------------
# Lives in the private workshop repo, not here.
#
# This repository is the APPLICATION. The marketing site, the promo/video
# sources and the day-to-day engineering notes are a different kind of thing
# with a different audience, and they carried machine-specific paths and
# personal identifiers. They still exist on the maintainer's disk and in
# `tachi-studio-workshop`; they just don't belong in a repo people clone to
# build the app.
/website/
/website-landing/
/claude-design/
/docs/app/
/.claude/
/.work/
/AUDIT-*.md
/docs/superpowers/
/docs/design/
/docs/promo/
/docs/SESSION-STATE.md
/docs/SECURITY-AUDIT.md
/docs/IMPLEMENTATION-PLAN.md
/docs/SPRINT-*.md

# One-off verification drivers and probes written while building a feature.
# `pnpm e2e` (apps/desktop/e2e/drive.mjs) is the one that is maintained.
/apps/desktop/e2e/*.mjs
!/apps/desktop/e2e/drive.mjs
/DESIGN.md
/.mcp.json.example
