{
  "appId": "studio.tachi.desktop",
  "productName": "Tachi Studio",
  "copyright": "Copyright 2026 TachikomaRed and Smolemaru contributors",
  "directories": {
    "output": "release-build",
    "buildResources": "build"
  },
  "afterPack": "./scripts/afterpack-verify.cjs",
  "files": [
    "out/**/*",
    "package.json",
    "!**/node_modules/@tachi/**",
    "!**/*.map",
    "!**/node_modules/**/.cache/**",
    "!release-build/**",
    "!release-build2/**",
    "!dist-rel/**",
    "!dist-release/**",
    "!resources/sidecars/**",
    "!**/win-unpacked.tmp/**",
    "!**/node_modules/@remotion/compositor-*/**",
    "!**/node_modules/onnxruntime-web/dist/*.wasm",
    "!**/node_modules/@huggingface/transformers/dist/*.wasm",
    "!**/node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**",
    "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
  ],
  "npmRebuild": false,
  "asarUnpack": [
    "**/node_modules/node-pty/**",
    "**/node_modules/@remotion/**",
    "**/node_modules/remotion/**",
    "**/node_modules/react/**",
    "**/node_modules/react-dom/**",
    "**/node_modules/@puppeteer/**",
    "**/node_modules/puppeteer-core/**",
    "**/node_modules/esbuild/**",
    "**/node_modules/@esbuild/**",
    "**/node_modules/onnxruntime-node/**",
    "**/node_modules/node-sqlite3-wasm/**",
    "**/node_modules/pdfjs-dist/**"
  ],
  "extraResources": [
    {
      "from": "../../NOTICE",
      "to": "NOTICE"
    },
    {
      "from": "../../THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "electron/services/providers/providers.yaml",
      "to": "providers/providers.yaml"
    },
    {
      "from": "../../scripts/patches",
      "to": "patches"
    },
    {
      "from": "resources/sidecars",
      "to": "sidecars",
      "filter": [
        "**/*",
        "!**/.git/**",
        "!**/.github/**",
        "!**/client/node_modules/**",
        "!**/node_modules/{vitest,@vitest,vite,vite-node,tsx,esbuild,@esbuild,@esbuild-kit,drizzle-kit,rollup,@rollup,typescript,@types}/**",
        "!**/node_modules/{@rolldown,rolldown,@tailwindcss,tailwindcss,@ts-morph,ts-morph,@babel,msw,@mswjs,caniuse-lite,recharts,lucide-react,@base-ui,react-dom,react-router,@reduxjs,@napi-rs}/**",
        "!**/node_modules/lightningcss-*/**",
        "!**/node_modules/better-sqlite3/deps/**",
        "!**/*.map",
        "!**/*.ts",
        "!freellmapi/server/data/**",
        "!goose/**",
        "!**/goose-download.*"
      ]
    },
    {
      "from": "electron/services/roles/roles.yaml",
      "to": "roles/roles.yaml"
    },
    {
      "from": "resources/skills",
      "to": "skills"
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "rpm",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Development",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Tachi Studio",
    "license": "../../LICENSE"
  },
  "publish": [
    {
      "provider": "github",
      "releaseType": "draft"
    }
  ]
}
