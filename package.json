    "lint": "eslint .",
    "prepare:sidecars": "node scripts/download-sidecars.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0"
  }
