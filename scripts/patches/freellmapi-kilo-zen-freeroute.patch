index 1f90f04..477d95d 100644
--- a/server/src/db/index.ts
+++ b/server/src/db/index.ts
@@ -47,6 +47,7 @@ export function initDb(dbPath?: string): Database.Database {
   migrateModelsV10(db);
   migrateModelsV11(db);
   migrateModelsV12(db);
+  migrateModelsV13(db);
   ensureUnifiedKey(db);
 
   console.log(`Database initialized at ${resolvedPath}`);
@@ -980,6 +981,158 @@ function migrateModelsV12(db: Database.Database) {
   apply();
 }
 
+/**
+ * LLM7's free tier is 100 requests per HOUR — their own figure, and the budget
+ * string V11 seeded on those rows literally reads "100/hr". V11 nonetheless
+ * wrote 100 into `rpm_limit`, a column services/ratelimit.ts prunes on a
+ * 60-SECOND window. The local limiter therefore permitted ~100 sends a MINUTE
+ * against a provider allowing 100 an hour, and — the symptom that surfaced it —
+ * never refused the immediate retry after a 429, spending it on a guaranteed
+ * second 429. This schema has no hourly bucket, so the cap is expressed in the
+ * window that actually exists: 1/min = 60/hr, under the ceiling, and an instant
+ * retry is now refused locally instead of on the wire.
+ */
+const LLM7_RPM_FROM_HOURLY_CAP = 1;
+
+/**
+ * V13 (2026-08-01): make the KEYLESS free route actually strong.
+ *
+ * This migration does three things, all driven by live probes taken the day it
+ * was written (nonce in every prompt, so a cached 200 could not be mistaken for
+ * a live answer):
+ *
+ * 1. ADD the two keyless upstreams that answer today.
+ *    - Kilo Gateway: 200 on every :free row with NO usable credential (a
+ *      garbage bearer also returns 200 — the header is ignored). The platform
+ *      was already registered upstream but carried exactly ONE catalog row, and
+ *      the host app never seeded it a key, so the router skipped it entirely.
+ *      It is the single best addition available: 1M-context nemotron, an omni /
+ *      reasoning row, and a dedicated coding row, all tool-capable.
+ *    - OpenCode Zen: 200 keyless on all six free rows. Ranked BELOW Kilo and
+ *      explicitly best-effort — OpenCode's docs say these need billing details
+ *      on file, yet they answer without; that gap can close without warning.
+ *      Requires `omitAuth` (a present-but-bogus bearer 401s).
+ *
+ * 2. ORDER them deliberately instead of appending. New rows normally land at
+ *    MAX(priority)+n, i.e. dead last, which would have buried the best upstream
+ *    behind everything. Four rows get an explicit NEGATIVE lead priority so the
+ *    free route reaches them first; the rest are appended at the tail where they
+ *    are reachable but not dominant. The lead band is deliberately small: the
+ *    router's dynamic penalty caps at MAX_PENALTY (10), so a lead row can sink
+ *    but never fall past the keyed providers — every lead row is therefore a
+ *    round-trip the user pays for if that upstream goes down. Four is the budget,
+ *    and the fourth is a DIFFERENT vendor so a total Kilo outage still fails over
+ *    across gateways rather than deeper into the same one.
+ *
+ * 3. DISABLE what is measurably dead. An upstream that 4xxs is worse than an
+ *    absent one, because it burns a failover attempt before the user gets an
+ *    answer. Measured this day, all with the anonymous placeholder the host app
+ *    seeds:
+ *      - ovh (all 4 rows): 403 x5 "Forbidden: authentication failed …
+ *        generate a new one at …/oauth/ovh/authorize". The anonymous tier this
+ *        platform was vendored for in V12 is GONE, replaced by an OAuth flow —
+ *        it is not merely rate-limited.
+ *      - pollinations openai-fast: 402 Payment Required x4, carrying a
+ *        deprecation notice for the legacy text API — and it took 22-24s to
+ *        return that 402 twice, the most expensive possible way to fail.
+ *      - llm7: 4 of its 5 rows 400 "Model is currently unavailable" (stale ids).
+ *        `codestral-latest` still answers 200 and is KEPT.
+ *    Disabling the model row (rather than deleting it) is reversible from the
+ *    dashboard if a provider brings its free tier back.
+ */
+function migrateModelsV13(db: Database.Database) {
+  const insert = db.prepare(`
