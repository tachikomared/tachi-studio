diff --git a/server/src/__tests__/db/v13-freeroute.test.ts b/server/src/__tests__/db/v13-freeroute.test.ts
new file mode 100644
index 0000000..feb4be7
--- /dev/null
+++ b/server/src/__tests__/db/v13-freeroute.test.ts
@@ -0,0 +1,80 @@
+import { describe, it, expect } from 'vitest';
+import { initDb } from '../../db/index.js';
+
+describe('V13 free-route shape', () => {
+  const db = initDb(':memory:');
+
+  const chain = db.prepare(`
+    SELECT m.platform, m.model_id, m.enabled, f.priority, f.enabled AS fb_enabled
+    FROM fallback_config f JOIN models m ON m.id = f.model_db_id
+    ORDER BY f.priority ASC
+  `).all() as Array<{ platform: string; model_id: string; enabled: number; priority: number; fb_enabled: number }>;
+
+  it('prints the head of the failover chain', () => {
+    // eslint-disable-next-line no-console
+    console.log('\n--- HEAD OF FAILOVER CHAIN ---');
+    for (const r of chain.slice(0, 10)) {
+      // eslint-disable-next-line no-console
+      console.log(`  p=${String(r.priority).padStart(4)}  ${r.platform.padEnd(13)} ${r.model_id.padEnd(50)} model.enabled=${r.enabled}`);
+    }
+    expect(chain.length).toBeGreaterThan(0);
+  });
+
+  it('the four lead slots are the keyless upstreams, Kilo first, Zen fourth', () => {
+    const head = chain.slice(0, 4).map(r => `${r.platform}:${r.model_id}`);
+    expect(head).toEqual([
+      'kilo:kilo-auto/free',
+      'kilo:nvidia/nemotron-3-ultra-550b-a55b:free',
+      'kilo:cohere/north-mini-code:free',
+      'zen:deepseek-v4-flash-free',
+    ]);
+  });
+
+  it('no ENABLED row of a measured-dead upstream sits ahead of the keyed providers', () => {
+    // Anything with a negative priority leads the chain. Nothing dead may be there.
+    const leaders = chain.filter(r => r.priority < 0 && r.enabled === 1);
+    for (const r of leaders) {
+      expect(['kilo', 'zen']).toContain(r.platform);
+    }
+  });
+
+  it('measured-dead rows are disabled so they cost no round-trip', () => {
+    const off = (platform: string, modelId: string) =>
+      (db.prepare('SELECT enabled FROM models WHERE platform = ? AND model_id = ?')
+        .get(platform, modelId) as { enabled: number } | undefined)?.enabled;
+
+    for (const id of ['Meta-Llama-3_3-70B-Instruct', 'gpt-oss-120b', 'Qwen3-Coder-30B-A3B-Instruct', 'Llama-3.1-8B-Instruct']) {
+      expect(off('ovh', id), `ovh/${id} must be disabled (403 keyless)`).toBe(0);
+    }
+    expect(off('pollinations', 'openai-fast'), 'pollinations 402').toBe(0);
+    for (const id of ['gpt-oss-20b', 'meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo', 'ministral-8b-2512', 'GLM-4.6V-Flash']) {
+      expect(off('llm7', id), `llm7/${id} must be disabled (400 unavailable)`).toBe(0);
+    }
+    // The one LLM7 row that still answers stays on.
+    expect(off('llm7', 'codestral-latest')).toBe(1);
+  });
+
+  it('LLM7 rate limit is stored per MINUTE, not its per-HOUR figure', () => {
+    // rpm_limit is pruned on a 60s window; LLM7 allows 100 per HOUR. Storing
+    // 100 here let the local limiter wave through an immediate post-429 retry.
+    const rows = db.prepare("SELECT model_id, rpm_limit FROM models WHERE platform = 'llm7'")
+      .all() as Array<{ model_id: string; rpm_limit: number | null }>;
+    expect(rows.length).toBeGreaterThan(0);
+    for (const r of rows) {
+      expect(r.rpm_limit, `llm7/${r.model_id} rpm_limit`).toBe(1);
+    }
+  });
+
+  it('all 14 new keyless rows exist and are enabled', () => {
+    const n = db.prepare("SELECT COUNT(*) AS c FROM models WHERE platform IN ('kilo','zen') AND enabled = 1").get() as { c: number };
+    // 9 kilo (8 new + the V11 nemotron-super row) + 6 zen
+    expect(n.c).toBe(15);
+  });
+
+  it('is idempotent — re-running initDb does not duplicate or reorder', () => {
+    const before = db.prepare('SELECT COUNT(*) AS c FROM fallback_config').get() as { c: number };
+    const db2 = initDb(':memory:');
+    const after = db2.prepare('SELECT COUNT(*) AS c FROM fallback_config').get() as { c: number };
+    expect(after.c).toBe(before.c);
+  });
+});
diff --git a/server/src/__tests__/routes/proxy-model-addressing.test.ts b/server/src/__tests__/routes/proxy-model-addressing.test.ts
new file mode 100644
index 0000000..bcb67a7
--- /dev/null
+++ b/server/src/__tests__/routes/proxy-model-addressing.test.ts
@@ -0,0 +1,225 @@
+import { describe, it, expect, beforeAll, beforeEach, afterEach, vi } from 'vitest';
+import type { Express } from 'express';
+import { createApp } from '../../app.js';
+import { initDb, getDb, getUnifiedApiKey } from '../../db/index.js';
+
+// Two defects this file exists to keep dead, both found on a packaged build:
+//
+//   1. A pinned model was unaddressable. The host app's composer sends
+//      `${platform}/${modelId}` (it has to — a bare id is ambiguous), and the
+//      relay only ever looked up bare ids, so EVERY pinned relay model 400'd
+//      with "is not in the catalog".
+//   2. A model that exists on two platforms was reachable on only one.
+//      `nvidia/nemotron-3-super-120b-a12b:free` is served by BOTH openrouter
+//      and kilo; the bare lookup returns whichever row was inserted first, so
+//      Kilo's copy could not be addressed by any string a client could send.
+//
+// And one routing defect: a dead credential returned a 502 to the caller
+// instead of failing over, which made a single stale key take down a router
+// whose entire purpose is to survive exactly that.
+
+async function request(app: Express, method: string, path: string, body?: any, headers: Record<string, string> = {}) {
+  const server = app.listen(0);
+  const addr = server.address() as any;
+  const url = `http://127.0.0.1:${addr.port}${path}`;
+
+  // NOTE: uses the ORIGINAL fetch on purpose. These tests stub global.fetch to
+  // fake upstreams, and the stub would otherwise swallow the test's own call to
+  // the express app and return a canned 200 that never touched the router.
+  const res = await originalFetch(url, {
+    method,
+    headers: { ...(body ? { 'Content-Type': 'application/json' } : {}), ...headers },
+    body: body ? JSON.stringify(body) : undefined,
+  });
+
+  const data = await res.text();
+  server.close();
+
+  let json: any = null;
+  try { json = JSON.parse(data); } catch { /* non-JSON body */ }
+
+  return { status: res.status, body: json, headers: res.headers, raw: data };
+}
+
+const originalFetch = global.fetch;
+
+function authHeaders() {
+  return { Authorization: `Bearer ${getUnifiedApiKey()}` };
+}
+
+function okCompletion(content = 'pong') {
+  return {
+    ok: true,
+    status: 200,
+    json: () => Promise.resolve({
+      id: 'chatcmpl-test', object: 'chat.completion', created: 0, model: 'm',
+      choices: [{ index: 0, message: { role: 'assistant', content }, finish_reason: 'stop' }],
+      usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },
+    }),
+  } as any;
+}
+
+// The literal shape OpenRouter returns for a revoked key. The relay's provider
+// reads `error.message` off the JSON body, so the fake has to answer json().
+function unauthorized() {
+  return {
+    ok: false,
+    status: 401,
+    statusText: 'Unauthorized',
+    json: () => Promise.resolve({ error: { message: 'User not found.', code: 401 } }),
+  } as any;
+}
+
+const MESSAGES = [{ role: 'user', content: 'ping' }];
+
+describe('proxy model addressing', () => {
+  let app: Express;
+
+  beforeAll(() => {
+    process.env.ENCRYPTION_KEY = '0'.repeat(64);
+    initDb(':memory:');
+    app = createApp();
+  });
+
+  beforeEach(async () => {
+    const db = getDb();
+    db.prepare('DELETE FROM api_keys').run();
+    db.prepare('DELETE FROM requests').run();
+    // Kilo needs a key row or the router skips the platform before it ever
+    // reaches the model — the exact bug that made Kilo invisible for a month.
+    const addKey = await request(app, 'POST', '/api/keys', {
+      platform: 'kilo', key: 'anonymous', label: 'anon',
+    });
+    expect(addKey.status).toBe(201);
+  });
+
+  afterEach(() => { vi.restoreAllMocks(); });
+
+  it('the collision is real: one model id, two platforms', () => {
+    const rows = getDb()
+      .prepare('SELECT platform FROM models WHERE model_id = ? ORDER BY id')
+      .all('nvidia/nemotron-3-super-120b-a12b:free') as Array<{ platform: string }>;
+    expect(rows.map(r => r.platform).sort()).toEqual(['kilo', 'openrouter']);
+  });
+
+  it('a bare colliding id resolves to the FIRST catalog row (openrouter), leaving kilo unreachable without a qualifier', async () => {
+    await request(app, 'POST', '/api/keys', { platform: 'openrouter', key: 'sk-or-test-000000000', label: 'or' });
+
+    const seen: string[] = [];
+    vi.spyOn(global, 'fetch').mockImplementation(async (url: any, init?: any) => {
+      const s = String(url);
+      if (s.includes('/chat/completions') && !s.includes('127.0.0.1')) { seen.push(s); return okCompletion(); }
+      return originalFetch(url, init);
+    });
+
+    const { status, headers } = await request(app, 'POST', '/v1/chat/completions', {
+      model: 'nvidia/nemotron-3-super-120b-a12b:free',
+      messages: MESSAGES,
+    }, authHeaders());
+
+    expect(status).toBe(200);
+    // Bare must keep meaning "the id as written" — `nvidia` is BOTH a vendor
+    // prefix and a platform name, so a split-first rule would break every
+    // OpenRouter/Kilo id that carries a vendor prefix.
+    expect(headers.get('X-Routed-Via')).toBe('openrouter/nvidia/nemotron-3-super-120b-a12b:free');
+    expect(seen.some(u => u.includes('openrouter.ai'))).toBe(true);
+  });
+
+  it('a platform-qualified id reaches THAT platform — the only way to address the kilo copy', async () => {
+    const seen: string[] = [];
+    vi.spyOn(global, 'fetch').mockImplementation(async (url: any, init?: any) => {
+      const s = String(url);
+      if (s.includes('/chat/completions') && !s.includes('127.0.0.1')) { seen.push(s); return okCompletion(); }
+      return originalFetch(url, init);
+    });
+
+    const { status, headers } = await request(app, 'POST', '/v1/chat/completions', {
+      model: 'kilo/nvidia/nemotron-3-super-120b-a12b:free',
+      messages: MESSAGES,
+    }, authHeaders());
+
+    expect(status).toBe(200);
+    expect(headers.get('X-Routed-Via')).toBe('kilo/nvidia/nemotron-3-super-120b-a12b:free');
+    expect(seen.some(u => u.includes('api.kilo.ai'))).toBe(true);
+    expect(seen.some(u => u.includes('openrouter.ai'))).toBe(false);
+  });
+
+  it('an unknown platform-qualified id still 400s, and says how to address one', async () => {
+    const { status, body } = await request(app, 'POST', '/v1/chat/completions', {
+      model: 'kilo/no-such-model',
+      messages: MESSAGES,
+    }, authHeaders());
+    expect(status).toBe(400);
+    expect(body.error.code).toBe('model_not_found');
+    expect(body.error.message).toContain('platform/model-id');
+  });
+});
+
+describe('proxy credential failover', () => {
+  let app: Express;
+
+  beforeAll(() => {
+    process.env.ENCRYPTION_KEY = '0'.repeat(64);
+    initDb(':memory:');
+    app = createApp();
+  });
+
+  beforeEach(() => {
+    const db = getDb();
+    db.prepare('DELETE FROM api_keys').run();
+    db.prepare('DELETE FROM requests').run();
+  });
+
+  afterEach(() => { vi.restoreAllMocks(); });
+
+  it('a 401 from one upstream fails over to the next instead of surfacing a 502', async () => {
+    // Two platforms with keys. OpenRouter answers 401 "User not found" — the
+    // literal body a revoked OpenRouter key returns, and the one that took the
+    // whole free route down on a packaged build.
+    await request(app, 'POST', '/api/keys', { platform: 'openrouter', key: 'sk-or-dead-key-000000', label: 'dead' });
+    await request(app, 'POST', '/api/keys', { platform: 'groq', key: 'gsk_live_key_000000', label: 'live' });
+
+    const seen: string[] = [];
+    vi.spyOn(global, 'fetch').mockImplementation(async (url: any, init?: any) => {
+      const s = String(url);
+      if (s.includes('127.0.0.1')) return originalFetch(url, init);
+      seen.push(s);
+      if (s.includes('openrouter.ai')) {
+        return unauthorized();
+      }
+      if (s.includes('api.groq.com')) return okCompletion();
+      return originalFetch(url, init);
+    });
+
+    const { status, body } = await request(app, 'POST', '/v1/chat/completions', {
+      messages: MESSAGES,
+    }, authHeaders());
+
+    expect(seen.some(u => u.includes('openrouter.ai'))).toBe(true);
+    expect(status).toBe(200);
+    expect(body.choices[0].message.content).toBe('pong');
+  });
+
+  it('the rejected key is marked invalid, so the NEXT request skips it entirely', async () => {
+    await request(app, 'POST', '/api/keys', { platform: 'openrouter', key: 'sk-or-dead-key-000000', label: 'dead' });
+    await request(app, 'POST', '/api/keys', { platform: 'groq', key: 'gsk_live_key_000000', label: 'live' });
+
+    vi.spyOn(global, 'fetch').mockImplementation(async (url: any, init?: any) => {
+      const s = String(url);
+      if (s.includes('127.0.0.1')) return originalFetch(url, init);
+      if (s.includes('openrouter.ai')) {
+        return unauthorized();
+      }
+      if (s.includes('api.groq.com')) return okCompletion();
+      return originalFetch(url, init);
+    });
+
+    await request(app, 'POST', '/v1/chat/completions', { messages: MESSAGES }, authHeaders());
+
+    const key = getDb().prepare("SELECT status FROM api_keys WHERE platform = 'openrouter'")
+      .get() as { status: string };
+    // Without this the 429 penalty (cap 10) is the only demotion there is, so a
+    // permanently-401ing row is re-picked on every send, forever.
+    expect(key.status).toBe('invalid');
+  });
+});
