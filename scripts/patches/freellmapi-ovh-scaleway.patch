+// OVHcloud AI Endpoints — OpenAI-compatible, EU/GDPR-hosted. The free
+// anonymous tier needs NO key (~2 rpm unauthenticated; an OVH key raises
+// limits). Same placeholder-key convention as Pollinations/LLM7: the router
+// filters on keys.length === 0, so add any non-empty string as the "key" to
+// make the platform routable. Slow models on the free tier — generous timeout.
+register(new OpenAICompatProvider({
+  platform: 'ovh',
+  name: 'OVHcloud AI Endpoints',
+  baseUrl: 'https://oai.endpoints.kepler.ai.cloud.ovh.net/v1',
+  timeoutMs: 60000,
+}));
+
+// Scaleway Generative APIs — OpenAI-compatible, EU-hosted. Free tier =
+// 1M tokens; needs an IAM secret key (no card).
+register(new OpenAICompatProvider({
+  platform: 'scaleway',
+  name: 'Scaleway Generative APIs',
+  baseUrl: 'https://api.scaleway.ai/v1',
+}));
+
