+/**
+ * V12 (2026-06-10): add OVHcloud AI Endpoints + Scaleway Generative APIs.
+ *
+ *  - OVH: OpenAI-compatible, EU/GDPR. Anonymous tier needs NO key (~2 rpm);
+ *    same placeholder-key convention as Pollinations/LLM7 to be routable.
+ *  - Scaleway: OpenAI-compatible, EU. 1M free tokens, IAM key required
+ *    (no card).
+ *
+ * Model ids below come from provider docs (2026-05 research pass) and OVH/SCW
+ * rename SLOWLY but DO drift — the health probe (test-all-models / per-key
+ * health checks) is the source of truth; a 404 "unknown model" row just sinks
+ * in the fallback chain, it cannot break routing.
+ */
+function migrateModelsV12(db: Database.Database) {
+  const insert = db.prepare(`
+    INSERT OR IGNORE INTO models (platform, model_id, display_name, intelligence_rank, speed_rank, size_label, rpm_limit, rpd_limit, tpm_limit, tpd_limit, monthly_token_budget, context_window)
+    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+  `);
+  const additions: Array<[string, string, string, number, number, string, number | null, number | null, number | null, number | null, string, number | null]> = [
+    // OVHcloud — anonymous ~2 rpm (keyed raises limits). EU-hosted.
+    // Ids PROBED LIVE 2026-06-10 against the keyless /v1/models (note the
+    // mixed naming: Meta-Llama-3_3 with underscores, Llama-3.1 with dots —
+    // that's how the live catalog actually spells them).
+    ['ovh',      'Meta-Llama-3_3-70B-Instruct',        'Llama 3.3 70B (OVH)',          17, 7, 'Large',  2, null, null, null, '~1M (anon 2rpm)', 131072],
+    ['ovh',      'gpt-oss-120b',                       'GPT-OSS 120B (OVH)',            6, 7, 'Large',  2, null, null, null, '~1M (anon 2rpm)', 131072],
+    ['ovh',      'Qwen3-Coder-30B-A3B-Instruct',       'Qwen3 Coder 30B (OVH)',        16, 7, 'Medium', 2, null, null, null, '~1M (anon 2rpm)', 131072],
+    ['ovh',      'Llama-3.1-8B-Instruct',              'Llama 3.1 8B (OVH)',           28, 8, 'Small',  2, null, null, null, '~1M (anon 2rpm)', 131072],
+
+    // Scaleway — 1M free tokens with an IAM key.
+    ['scaleway', 'llama-3.3-70b-instruct',             'Llama 3.3 70B (SCW)',          17, 7, 'Large',  null, null, null, null, '1M free tokens', 131072],
+    ['scaleway', 'qwen2.5-coder-32b-instruct',         'Qwen2.5 Coder 32B (SCW)',      20, 7, 'Medium', null, null, null, null, '1M free tokens',  32768],
+    ['scaleway', 'mistral-small-3.1-24b-instruct-2503','Mistral Small 3.1 24B (SCW)',  21, 8, 'Medium', null, null, null, null, '1M free tokens', 131072],
+  ];
+
+  const apply = db.transaction(() => {
+    for (const a of additions) insert.run(...a);
+    const missing = db.prepare(`
+      SELECT m.id FROM models m
+      LEFT JOIN fallback_config f ON m.id = f.model_db_id
+      WHERE f.id IS NULL ORDER BY m.intelligence_rank ASC
+    `).all() as { id: number }[];
+    if (missing.length > 0) {
+      const maxPriority = (db.prepare('SELECT COALESCE(MAX(priority), 0) AS mx FROM fallback_config').get() as { mx: number }).mx;
+      const addFb = db.prepare('INSERT INTO fallback_config (model_db_id, priority, enabled) VALUES (?, ?, 1)');
+      for (let i = 0; i < missing.length; i++) addFb.run(missing[i].id, maxPriority + i + 1);
+    }
+  });
+  apply();
+}
+
 function ensureUnifiedKey(db: Database.Database) {
   const existing = db.prepare("SELECT value FROM settings WHERE key = 'unified_api_key'").get() as { value: string } | undefined;
   if (!existing) {
